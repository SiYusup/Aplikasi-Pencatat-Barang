{
  "name": "u-crazy/aplikasi-pencatat-barang-crud",
  "description": "Belajar MVC memakai RestfulAPI",
  "type": "project",
  "require": {
    "php": ">=8.1",
    "vlucas/phpdotenv": "^5.7",
    "dompdf/dompdf": "^3.1",
    "phpoffice/phpspreadsheet": "^5.10"
  },
  "require-dev": {
    "phpunit/phpunit": "^13.3"
  },
  "autoload": {
    "psr-4": {
      "UCrazy\\AplikasiPencatatBarangCrud\\": "app/"
    },
    "classmap": [
      "app/Model/Requests.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "UCrazy\\AplikasiPencatatBarangCrud\\Test\\": "tests/"
    }
  },
  "authors": [
    {
      "name": "UCrazy",
      "email": "finder.ucup@gmail.com"
    }
  ]
